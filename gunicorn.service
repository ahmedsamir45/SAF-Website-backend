[Unit]
Description=Gunicorn service for SAF Backend
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/saf-backend
Environment="PATH=/var/www/saf-backend/venv/bin"
ExecStart=/var/www/saf-backend/venv/bin/gunicorn --workers 3 --bind unix:/var/www/saf-backend/saf_backend.sock SAF_backend.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
